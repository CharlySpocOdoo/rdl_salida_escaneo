<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_rdl_salida_escaneo" model="ir.ui.view">
        <field name="name">stock.picking.type.form.rdl_salida_escaneo</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Revisión por escaneo" name="rdl_salida_escaneo" invisible="code != 'outgoing'">
                    <field name="rdl_exigir_escaneo"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
